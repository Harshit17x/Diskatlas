{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskAtlas",
  "version": "1.0.0",
  "identifier": "com.diskatlas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskAtlas - Storage Intelligence",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Premium Local-First Storage Intelligence Desktop App",
    "longDescription": "DiskAtlas is an ultra-fast, local-first disk intelligence desktop application engineered with Tauri 2, Rust, React 19, and SQLite. It provides deep filesystem analytics, developer storage profiling, duplicate discovery, and safe reversible cleanup without remote telemetry.",
    "copyright": "Copyright © 2026 Harshit Bisht. All rights reserved.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["en-US"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
